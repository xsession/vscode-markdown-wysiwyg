---
name: Register map to HTML
format: html
struct_name: demoFpgaRegs
---
{#-
  register-map-to-xml.j2 — register-map Markdown document to a standalone
  HTML page: one <section> per register with a field/value table, plus a
  struct section when struct_name is set.
-#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>Register map — {{ source | xml_escape }}</title>
<style>
body { font-family: sans-serif; margin: 2em auto; max-width: 60em; color: #222; }
h1 { border-bottom: 2px solid #333; }
section { margin-bottom: 2em; }
h2 small { color: #666; font-weight: normal; }
table { border-collapse: collapse; margin-top: .5em; }
th, td { border: 1px solid #999; padding: .3em .6em; text-align: left; }
th { background: #eee; }
code { background: #f4f4f4; padding: 0 .3em; }
</style>
</head>
<body>
<h1>Register map <small>from {{ source | xml_escape }}</small></h1>
<p>Regenerated by register-map-to-html.j2</p>
{%- for r in rows %}
<!-- @register {{ r.Name }} -->
<section>
<h2>{{ r.Name | xml_escape }} <small>offset {{ r.Offset | xml_escape }} · word {{ r.Word | xml_escape }} · {{ r.Size | size_bits }} bit · {{ r.Access | access_flags | join(', ') | xml_escape }}</small></h2>
<p>{{ r | row_doc | xml_escape }}</p>
{%- if r.Format == 'array' %}
<p>Array: {{ r.Description | array_info.length }} × u{{ r.Description | array_info.bit_width }}</p>
{%- elif r.Format == 'enum' %}
<table>
<tr><th>Value</th><th>Name</th></tr>
{%- for v in r | row_subrows %}
<tr><td>{{ v[0] | int }}</td><td>{{ v[1] | xml_escape }}</td></tr>
{%- endfor %}
</table>
{%- elif r.Format == 'bitfield' %}
<table>
<tr><th>Offset</th><th>Name</th><th>Size</th><th>Description</th></tr>
{%- for f in r | row_subrows %}
{%- if f[1] == 'reserved' %}
<tr><td>{{ f[0] | xml_escape }}</td><td>{{ r.Name }}_padding</td><td>{{ f[2] | size_bits }} bit</td><td>N/A</td></tr>
{%- else %}
<tr><td>{{ f[0] | xml_escape }}</td><td>{{ f[1] | xml_escape }}</td><td>{{ f[2] | size_bits }} bit</td><td>{{ f[4] | default('N/A') | xml_escape }}</td></tr>
{%- endif %}
{%- endfor %}
</table>
{%- endif %}
</section>
{%- endfor %}
{%- if params.struct_name %}
<!-- @register {{ params.struct_name }} -->
<section>
<h2>Struct: {{ params.struct_name | xml_escape }}</h2>
<table>
<tr><th>Member</th><th>Reference</th></tr>
{%- for r in rows %}
<tr><td>{{ r.Name | xml_escape }}</td><td><code>EXT__{{ r.Name | xml_escape }}</code></td></tr>
{%- endfor %}
</table>
</section>
{%- endif %}
</body>
</html>
